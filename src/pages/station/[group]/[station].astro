---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PriceTable from "../../../components/PriceTable.astro";
import ProgramLinks from "../../../components/ProgramLinks.astro";
import ReviewSection from "../../../components/ReviewSection.astro";
import { SITE, sidoName } from "../../../lib/site";
import {
  stations,
  getSido,
  getSigungu,
  nearbyStationsOf,
  isIndexable,
} from "../../../lib/data";
import {
  breadcrumbSchema,
  faqSchema,
  serviceAreaSchemaWithReviews,
} from "../../../lib/seo";
import { reviewsForArea, ratingForArea } from "../../../lib/reviews";
import { stationIntro, stationLife, stationAccess, stationFare, stationFareTail, stationVisitLead } from "../../../lib/prose";

export function getStaticPaths() {
  return stations.map((st) => ({
    params: { group: st.stationGroup, station: st.stationSlug },
    props: { st },
  }));
}

const { st } = Astro.props;
const path = `/station/${st.stationGroup}/${st.stationSlug}/`;
const noindex = !isIndexable(st.contentStatus);
const sido = getSido(st.stationGroup);
const sigungu = getSigungu(st.stationGroup, st.sigunguSlug);
const neighbors = nearbyStationsOf(st, 5);

// 본문 보강용 (빈 배열 폴백)
const na = st.nearbyAreas.length ? st.nearbyAreas : [`${st.stationName} 일대`];
const lines = st.transferLines.length ? st.transferLines : ["도시철도"];

const title = `${st.stationName} 출장마사지｜${st.nearbyAreas
  .slice(0, 2)
  .join("·")} 인접 생활권 홈타이 안내`;
const description = `${st.stationName} 출장마사지 예약 전 ${st.nearbyAreas
  .slice(0, 3)
  .join("·")} 주변 생활권을 확인하세요.`;

const faq = [
  {
    q: `${st.stationName} 주변 출장마사지·홈타이는 어떻게 예약하나요?`,
    a: `전화예약 ${SITE.phone}로 ${st.stationName} 인근 방문 위치와 가능 주소, 희망 시간을 알려주시면 방문 가능 생활권과 추가 이동비 기준을 안내드립니다.`,
  },
  {
    q: `${st.stationName}은 환승역인데 페이지가 하나인가요?`,
    a: `네. 환승역이라도 노선별·출구별로 페이지를 나누지 않고 역명 기준으로 하나의 안내 페이지를 제공합니다. ${
      st.transferYn ? st.transferLines.join(", ") + " 환승 정보를 함께 안내합니다." : ""
    }`,
  },
];

// 역 시드 셔플 후기 — 역명 슬러그 기준으로 페이지마다 다른 6개 노출
const stReviews = reviewsForArea(
  st.stationGroup,
  `station/${st.sigunguSlug}/${st.stationSlug}`,
  6
);
const stRating = ratingForArea(
  st.stationGroup,
  `station/${st.sigunguSlug}/${st.stationSlug}`,
  stReviews
);

// 시드 문장 변형 — 역마다 본문 문단 구조가 달라진다 (중복 본문 방지)
const stSeed = `${st.stationGroup}/${st.stationSlug}`;
const svars = {
  station: st.stationName,
  sido: st.sido,
  sigungu: st.sigungu,
  focus: st.contentFocus,
  areas: na,
  lines,
  transfer: st.transferYn,
};
const stIntroText = stationIntro(stSeed, svars);
const stLifeText = stationLife(stSeed, svars);
const stAccessText = stationAccess(stSeed, svars);
const stFareText = stationFare(stSeed, svars);
const stFareTailText = stationFareTail(stSeed, svars);
const stVisitLeadText = stationVisitLead(stSeed, svars);

const schema = noindex
  ? []
  : [
      breadcrumbSchema([
        { name: "홈", path: "/" },
        { name: "지하철역 안내", path: "/station/" },
        { name: `${sido?.regionName} 역`, path: `/station/${st.stationGroup}/` },
        { name: st.stationName, path },
      ]),
      serviceAreaSchemaWithReviews(
        `${st.stationName} 인근`,
        path,
        stReviews,
        stRating.avg
      ),
      faqSchema(faq),
    ];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  schema={schema}
>
  <Breadcrumbs
    items={[
      { name: "홈", path: "/" },
      { name: "지하철역 안내", path: "/station/" },
      { name: `${sido?.regionName} 역`, path: `/station/${st.stationGroup}/` },
      { name: st.stationName },
    ]}
  />

  <section class="section" style="padding-top:8px">
    <div class="container prose">
      <span class="eyebrow">{sidoName(st.stationGroup)} · {st.sigungu}</span>
      <h1>{st.stationName} 출장마사지 · 역 주변 홈타이 예약 안내</h1>

      <h2>{st.stationName} 주변에서 출장마사지를 찾을 때 확인할 기준</h2>
      <p>{stIntroText}</p>

      <h2>{st.stationName} 인근 생활권 안내</h2>
      <p>{st.stationName} 주변의 대표 생활권과 인접 행정동은 다음과 같습니다.</p>
      <ul>
        {st.nearbyAreas.map((a) => <li>{a}</li>)}
      </ul>
      <p>{stLifeText}</p>

      <h2>{st.stationName} 주변 방문 가능 지역</h2>
      <p>{stAccessText}</p>
      <table class="info-table">
        <tbody>
          <tr><th>역명</th><td>{st.stationName}</td></tr>
          <tr><th>소재 지역</th><td>
            {
              sigungu ? (
                <a href={`/area/${st.stationGroup}/${st.sigunguSlug}/`}>{st.sido} {st.sigungu}</a>
              ) : (
                `${st.sido} ${st.sigungu}`
              )
            }
          </td></tr>
          <tr><th>노선</th><td>{st.transferLines.join(", ")}</td></tr>
          <tr><th>주소</th><td>{st.address}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 요금표 (메인 + 모든 지역 페이지 공통) -->
  <PriceTable areaLabel={st.stationName} seed={`${st.stationGroup}/${st.stationSlug}`} />

  <section class="section">
    <div class="container prose">
      <h2>주변 지역과 가까운 역 안내</h2>
      <p>{sido?.regionName}의 인접 역도 함께 확인해 보세요.</p>
      <div class="chip-list">
        {
          neighbors.map((n) => (
            <a class="chip" href={`/station/${n.stationGroup}/${n.stationSlug}/`}>{n.stationName}</a>
          ))
        }
        {
          sigungu && (
            <a class="chip chip--soft" href={`/area/${st.stationGroup}/${st.sigunguSlug}/`}>
              {st.sigungu} 지역 안내
            </a>
          )
        }
      </div>

      <p>
        {st.sido}에서는 {neighbors.map((n) => n.stationName).join(", ")} 등 인접
        역과 함께 {st.stationName} 생활권을 비교해 방문 위치를 정하는 분이 많습니다.
        역마다 주변 상권과 주거 분포가 달라, 같은 {st.sido} 안에서도 방문 가능
        지역과 동선이 다르므로 가까운 역 안내를 함께 살펴보면 도움이 됩니다.
        {st.stationName}은 역명 기준 하나의 페이지로 안내하며, 출구·노선별로
        나누지 않습니다.
      </p>

      <h2>자택·숙소·오피스텔 이용 전 확인사항</h2>
      <p>
        <a href="/service/home/">자택</a>, <a href="/service/hotel/">호텔·숙소</a>,
        <a href="/service/officetel/">오피스텔</a> — {stVisitLeadText}
        예약 전 <a href="/guide/before-use/">이용 전 확인사항</a>도 함께 확인하세요.
      </p>

      <h2>추가 이동비 확인 기준</h2>
      <p>{stFareText}</p>
      <p>{stFareTailText}</p>

      <div class="notice notice--warn">
        <div class="notice__title">예약 안내</div>
        <p style="margin:0">
          전화예약 <a href={SITE.phoneHref}>{SITE.phone}</a> 로 문의해 주세요.
          불법·선정적 서비스는 제공하지 않습니다.
        </p>
      </div>

      <ProgramLinks
        limit={8}
        seed={stSeed}
        prefix={st.stationName}
        title={`${st.stationName} 마사지 프로그램 안내`}
        lead={`${st.stationName} 인근에서 받을 수 있는 관리 종류별 안내입니다.`}
      />

      <h2>{st.stationName} 자주 묻는 질문</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {!noindex && stReviews.length > 0 && (
    <ReviewSection areaName={`${st.stationName} 인근`} reviews={stReviews} displayRating={stRating.avg} />
  )}
</BaseLayout>
