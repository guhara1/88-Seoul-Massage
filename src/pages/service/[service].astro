---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ReviewSection from "../../components/ReviewSection.astro";
import { SITE } from "../../lib/site";
import { services, prioritySigungus } from "../../lib/data";
import {
  breadcrumbSchema,
  faqSchema,
  serviceSchemaWithReviews,
} from "../../lib/seo";
import { reviewsBySeed, ratingFor } from "../../lib/reviews";
import { serviceIntro, serviceNotice } from "../../lib/prose";

export function getStaticPaths() {
  return services.map((sv) => ({ params: { service: sv.slug }, props: { sv } }));
}

const { sv } = Astro.props;
const path = `/service/${sv.slug}/`;
const others = services.filter((x) => x.slug !== sv.slug);

const svIntroText = serviceIntro(sv.slug, {
  name: sv.name,
  short: sv.shortName,
  focus: sv.focus,
  point: sv.points[0] ?? sv.focus,
});
const svNoticeText = serviceNotice(sv.slug);

const title = `${sv.name}｜${SITE.name} 출장마사지·홈타이`;
const description = sv.summary;

const faq = [
  {
    q: `${sv.shortName} 관리는 어떻게 예약하나요?`,
    a: `전화예약 ${SITE.phone}로 방문 위치와 가능 주소, 희망 시간을 알려주시면 안내드립니다.`,
  },
];

// 서비스 × 지역 롱테일 내부링크
const sidoLong = [
  { slug: "seoul", name: "서울" },
  { slug: "gyeonggi", name: "경기" },
  { slug: "incheon", name: "인천" },
  { slug: "busan", name: "부산" },
].map((s) => ({ ...s, gus: prioritySigungus(s.slug).slice(0, 5) }));

// 서비스 후기·평점 (전체 풀에서 슬러그 시드)
const svReviews = reviewsBySeed(`service/${sv.slug}`, 6);
const svRating = ratingFor(svReviews);

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "서비스 안내", path: "/service/chuljang/" },
    { name: sv.name, path },
  ]),
  serviceSchemaWithReviews(
    {
      name: sv.name,
      serviceType: sv.focus,
      description: sv.summary,
      path,
    },
    svReviews,
    svRating.avg
  ),
  faqSchema(faq),
];
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs
    items={[
      { name: "홈", path: "/" },
      { name: "서비스 안내", path: "/service/chuljang/" },
      { name: sv.name },
    ]}
  />
  <section class="section" style="padding-top:8px">
    <div class="container prose">
      <span class="eyebrow">서비스 안내</span>
      <h1>{sv.name}</h1>
      <p>{sv.summary}</p>

      <h2>{sv.shortName} 관리 기준</h2>
      <p>{svIntroText}</p>
      <ul>
        {sv.points.map((p) => <li>{p}</li>)}
      </ul>

      <div class="notice">
        <div class="notice__title">예약 전 확인</div>
        <p style="margin:0">
          방문 위치(<a href="/service/home/">자택</a> ·
          <a href="/service/hotel/">호텔·숙소</a> ·
          <a href="/service/officetel/">오피스텔</a>) — {svNoticeText}
          <a href="/guide/before-use/">이용 전 확인사항</a>과
          <a href="/reservation/">예약 안내</a>를 함께 확인하세요.
        </p>
      </div>

      <h2>지역별 {sv.shortName} 안내</h2>
      <p class="muted" style="font-size:0.9375rem">
        서울·경기·인천·부산 주요 지역에서 {sv.shortName} 방문 가능 생활권을
        확인하세요. 지역 페이지에서 가까운 동선을 살펴볼 수 있습니다.
      </p>
      {
        sidoLong.map((s) => (
          <div style="margin:10px 0">
            <strong style="font-size:0.9375rem">
              <a href={`/area/${s.slug}/`}>{s.name}</a>
            </strong>
            <div class="chip-list" style="margin-top:6px">
              {s.gus.map((g) => (
                <a class="chip chip--soft" href={`/area/${s.slug}/${g.regionSlug}/`}>
                  {g.regionName} {sv.shortName}
                </a>
              ))}
            </div>
          </div>
        ))
      }

      <h2>다른 서비스 안내</h2>
      <div class="chip-list">
        {
          others.map((o) => (
            <a class="chip" href={`/service/${o.slug}/`}>{o.shortName}</a>
          ))
        }
      </div>

      <div class="notice notice--warn">
        <div class="notice__title">예약 안내</div>
        <p style="margin:0">
          전화예약 <a href={SITE.phoneHref}>{SITE.phone}</a> 로 문의해 주세요.
          본 안내는 관리 방식과 예약 기준 중심이며, 불법·선정적 서비스는 제공하지
          않습니다.
        </p>
      </div>

      <h2>자주 묻는 질문</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {svReviews.length > 0 && (
    <ReviewSection
      areaName={sv.shortName}
      reviews={svReviews}
      displayRating={svRating.avg}
    />
  )}
</BaseLayout>
