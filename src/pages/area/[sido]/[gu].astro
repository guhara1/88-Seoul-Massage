---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import LocalNav from "../../../components/LocalNav.astro";
import PriceTable from "../../../components/PriceTable.astro";
import ProgramLinks from "../../../components/ProgramLinks.astro";
import ReviewSection from "../../../components/ReviewSection.astro";
import { SITE, sidoName } from "../../../lib/site";
import {
  sigungus,
  getSido,
  sigungusBySido,
  stations,
  stationsInSigungu,
  dongsOf,
  hasDongDetail,
  isIndexable,
  gusOfCity,
} from "../../../lib/data";
import {
  breadcrumbSchema,
  faqSchema,
  serviceAreaSchemaWithReviews,
} from "../../../lib/seo";
import { reviewsForArea, ratingForArea } from "../../../lib/reviews";
import { guIntro, guReserveIntro, guVisitNote, guNeighbor, guHeroSub, guLifeLead, guAreaLead, guStationLead, checklistItems, h1Gu, h2Intro, h2Reserve } from "../../../lib/prose";

export function getStaticPaths() {
  return sigungus.map((g) => ({
    params: { sido: g.parentSlug, gu: g.regionSlug },
    props: { g },
  }));
}

const { g } = Astro.props;
const sido = getSido(g.parentSlug)!;
const path = `/area/${g.parentSlug}/${g.regionSlug}/`;
const noindex = !isIndexable(g.contentStatus);

// 행정구를 둔 시(市)는 동 대신 구 카드를 먼저 노출 (시 → 구 → 동)
const cityGus = gusOfCity(g.parentSlug, g.regionSlug);
const hasGu = cityGus.length > 0;

// 대표 행정동 (ㄱㄴㄷ 정렬, 번호동 통합). 데이터 없으면 nearbyAreas 폴백
const dongList = dongsOf(g.parentSlug, g.regionSlug);
const fallbackAreas = g.nearbyAreas.map((a) => ({ name: a, slug: "", blurb: "" }));
const areaList = dongList.length ? dongList : fallbackAreas;

// 본문 보강용 — 행정동 수에 반비례해 분량 조절(2,000~2,500자 유지)
const ns = g.nearbyStations.length ? g.nearbyStations : ["인근 역"];
const pairA0 = areaList[0]?.name ?? g.regionName;
const pairA1 = areaList[1]?.name ?? pairA0;
const pairA2 = areaList[2]?.name ?? pairA1;
const smallList = areaList.length <= 9;
// 행정동이 많은(밀집) 구는 분량이 커지므로 일부 보강 문단을 줄여 2,500자 이내 유지
const dense = areaList.length > 10;
const clampBlurb = (t: string) =>
  t.length > 50 ? t.slice(0, 49).trimEnd() + "…" : t;

// 역세권: 이 지역 소속 역 + 데이터에 등록된 인접역
const guStations = stationsInSigungu(g.parentSlug, g.regionSlug);
const stationByName = (name: string) =>
  stations.find((st) => st.stationName === name);

// 인접 지역
const neighbors = sigungusBySido(g.parentSlug)
  .filter((x) => x.regionSlug !== g.regionSlug)
  .slice(0, 8);

// 권위 있는 외부 참고 링크 (공식 교통·행정 기관) — E-E-A-T 신뢰 신호
const authRefMap: Record<string, { label: string; href: string }> = {
  seoul: { label: "서울교통공사 노선도", href: "https://www.seoulmetro.co.kr/kr/cyberStation.do" },
  gyeonggi: { label: "경기도청 교통 안내", href: "https://www.gg.go.kr/" },
  incheon: { label: "인천교통공사 노선도", href: "https://www.ictr.or.kr/" },
  busan: { label: "부산교통공사 노선도", href: "https://www.humetro.busan.kr/" },
};
const authRef = authRefMap[g.parentSlug];

const title = `${g.regionName} 출장마사지｜${g.nearbyAreas
  .slice(0, 2)
  .join("·")} 생활권 홈타이 안내`;
const description = `${g.regionName} 출장마사지 예약 전 ${g.nearbyAreas
  .slice(0, 3)
  .join("·")} 인접 생활권을 확인하세요.`;

const faq = [
  {
    q: `${g.regionName} 출장마사지·홈타이는 어떻게 예약하나요?`,
    a: `전화예약 ${SITE.phone}로 ${g.regionName} 내 방문 위치와 가능 주소, 희망 시간을 알려주시면 방문 가능 생활권과 추가 이동비 기준을 안내드립니다.`,
  },
  {
    q: `${g.regionName} 기본 요금은 어떻게 되나요?`,
    a: `60분 90,000원, 90분 150,000원, 120분 180,000원을 기본으로 안내합니다. 방문 지역·시간대·이동 거리에 따라 최종 금액은 통화 시 확정됩니다.`,
  },
  {
    q: `${g.regionName} 추가 이동비 기준이 궁금합니다.`,
    a: `지역과 시간대, 거리에 따라 추가 이동비가 발생할 수 있습니다. 예약 전 전화로 정확한 기준을 확인하실 수 있습니다.`,
  },
];

// 시드 기반 셔플 — 페이지마다 다른 6개 노출 (동일 본문 도어웨이 신호 완화)
const areaReviews = reviewsForArea(g.parentSlug, g.regionSlug, 6);
const rating = ratingForArea(g.parentSlug, g.regionSlug, areaReviews);

// 시드 기반 문장 변형 — 지역마다 본문 문단 구조가 달라진다 (중복 본문 방지)
const gseed = `${g.parentSlug}/${g.regionSlug}`;
const gvars = {
  region: g.regionName,
  sido: sido.regionName,
  focus: g.contentFocus,
  areas: g.nearbyAreas,
  stations: ns,
};
const introParas = guIntro(gseed, gvars);
const heroSub = guHeroSub(gseed, gvars);
const guReserveIntroText = guReserveIntro(gseed, gvars);
const guVisitNoteText = guVisitNote(gseed, gvars);
const guNeighborText = guNeighbor(gseed, gvars);
const checkItems = checklistItems(gseed);
const guLifeLeadText = guLifeLead(gseed, gvars);
const guAreaLeadText = guAreaLead(gseed, gvars);
const guStationLeadText = guStationLead(gseed, gvars);
const h1Text = h1Gu(gseed, g.regionName);
const h2IntroText = h2Intro(gseed, g.regionName);
const h2ReserveText = h2Reserve(gseed, g.regionName);

const schema = noindex
  ? []
  : [
      breadcrumbSchema([
        { name: "홈", path: "/" },
        { name: "지역 안내", path: "/area/" },
        { name: sido.regionName, path: `/area/${g.parentSlug}/` },
        { name: g.regionName, path },
      ]),
      serviceAreaSchemaWithReviews(g.regionName, path, areaReviews, rating.avg),
      faqSchema(faq),
    ];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  schema={schema}
>
  <LocalNav homeLabel={g.regionName} homeHref={path} />
  <Breadcrumbs
    items={[
      { name: "홈", path: "/" },
      { name: "지역 안내", path: "/area/" },
      { name: sido.regionName, path: `/area/${g.parentSlug}/` },
      { name: g.regionName },
    ]}
  />

  <!-- 헤더 -->
  <section class="section" style="padding:8px 0 24px">
    <div class="container prose">
      <span class="eyebrow">{sidoName(g.parentSlug)} · {g.regionName}</span>
      <h1>{h1Text}</h1>
      <p class="hero__sub" style="color:var(--text-soft)">{heroSub}</p>
      <div class="hero__cta" style="margin-top:18px">
        <a class="btn btn--cta" href="#areas">지역별 안내 보기</a>
        <a class="btn btn--blue" href="#stations">가까운 역 찾기</a>
        <a class="btn btn--outline" href="/reservation/">예약 안내</a>
        <a class="btn btn--outline" href="/guide/before-use/">이용 전 확인사항</a>
      </div>
    </div>
  </section>

  <!-- 먼저 확인할 기준 -->
  <section class="section" style="padding-top:0">
    <div class="container prose">
      <h2>{h2IntroText}</h2>
      {introParas.map((para) => <p>{para}</p>)}
      <p>
        {g.regionName} 출장마사지 예약은 <a href={SITE.phoneHref}>{SITE.phone}</a>로
        문의해 주세요.
      </p>
    </div>
  </section>

  <!-- 요금표 (메인 + 모든 지역 페이지 공통) -->
  <PriceTable areaLabel={g.regionName} seed={gseed} />

  <!-- 지역별 안내 -->
  <section class="section section-anchor" id="areas">
    <div class="container">
      {
        hasGu ? (
          <Fragment>
            <div class="section__head">
              <span class="eyebrow">행정구 안내</span>
              <h2 class="section__title">{g.regionName} 행정구별 방문 가능 지역 안내</h2>
              <p class="section__lead">
                {g.regionName}은 {cityGus.length}개 행정구로 나뉩니다. 구를
                선택하면 소속 행정동과 인근 역, 이용 전 확인사항을 확인할 수
                있습니다.
              </p>
            </div>
            <div class="grid grid--3">
              {cityGus.map((gu) => (
                <a class="card" href={`/area/${g.parentSlug}/${g.regionSlug}/${gu.regionSlug}/`}>
                  <div class="card__title">{gu.regionName} <span class="arrow">→</span></div>
                  <p class="card__desc">{gu.contentFocus}</p>
                </a>
              ))}
            </div>
          </Fragment>
        ) : (
          <Fragment>
            <div class="section__head">
              <span class="eyebrow">지역별 안내</span>
              <h2 class="section__title">{g.regionName} 대표 지역별 방문 가능 지역 안내</h2>
              <p class="section__lead">{guAreaLeadText}</p>
            </div>
            <div class="area-rows">
              {areaList.map((d) => {
                const href =
                  d.slug && hasDongDetail(g.parentSlug, g.regionSlug, d.slug)
                    ? `/area/${g.parentSlug}/${g.regionSlug}/${d.slug}/`
                    : null;
                const Tag = href ? "a" : "div";
                return (
                  <Tag class="area-row" href={href} id={d.slug ? `dong-${d.slug}` : undefined}>
                    <b>{d.name} {href && <span class="arrow">→</span>}</b>
                    <span>
                      {clampBlurb(
                        d.blurb ||
                          `${g.regionName} ${d.name} 일대 주거지와 상권을 포함한 생활권입니다.`
                      )}
                    </span>
                  </Tag>
                );
              })}
            </div>
          </Fragment>
        )
      }
    </div>
  </section>

  <!-- 역세권 안내 -->
  <section class="section section--soft section-anchor" id="stations">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">역세권 안내</span>
        <h2 class="section__title">{g.regionName} 주요 지하철역별 홈타이 안내</h2>
        <p class="section__lead">{guStationLeadText}</p>
      </div>
      {
        guStations.length === 0 ? (
          <p class="muted">역세권 상세 안내는 순차적으로 확장됩니다.</p>
        ) : dense ? (
          <div class="chip-list">
            {guStations.map((st) => (
              <a class="chip" href={`/station/${st.stationGroup}/${st.stationSlug}/`}>{st.stationName}</a>
            ))}
          </div>
        ) : (
          <div class="grid grid--3">
            {guStations.map((st) => (
              <a class="card" href={`/station/${st.stationGroup}/${st.stationSlug}/`}>
                <div class="card__title">{st.stationName} <span class="arrow">→</span></div>
                <p class="card__desc">{st.nearbyAreas.slice(0, 3).join(", ")} 인접 생활권입니다. 방문 주소와 건물 출입 가능 여부를 먼저 확인하세요.</p>
              </a>
            ))}
          </div>
        )
      }
      <div class="chip-list" style="margin-top:16px">
        {
          g.nearbyStations.map((name) => {
            const st = stationByName(name);
            return st ? (
              <a class="chip chip--soft" href={`/station/${st.stationGroup}/${st.stationSlug}/`}>{name}</a>
            ) : (
              <span class="chip chip--soft">{name}</span>
            );
          })
        }
      </div>
      {
        authRef && (
          <p class="muted" style="font-size:0.875rem;margin-top:14px">
            {g.regionName} 인근 지하철 노선과 역 위치는 공식 기관 자료인{" "}
            <a href={authRef.href} target="_blank" rel="noopener">
              {authRef.label}
            </a>
            에서 함께 확인할 수 있습니다.
          </p>
        )
      }
    </div>
  </section>

  <!-- 생활권 안내 -->
  <section class="section section-anchor" id="life">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">생활권 안내</span>
        <h2 class="section__title">{g.regionName} 인근 생활권 예약 기준</h2>
        <p class="section__lead">{guLifeLeadText}</p>
      </div>
      <div class="chip-list">
        {
          sido.lifeAreas.map((l) => (
            <a class="chip" href="/life/">{l}</a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 마사지 프로그램 내부링크 (롱테일) -->
  <section class="section">
    <div class="container">
      <ProgramLinks
        limit={8}
        seed={gseed}
        prefix={g.regionName}
        title={`${g.regionName} 마사지 프로그램 안내`}
        lead={`${g.regionName}에서 받을 수 있는 관리 종류별 안내입니다.`}
      />
    </div>
  </section>

  <!-- 이용 전 확인사항 -->
  <section class="section section--soft">
    <div class="container prose">
      <h2>{h2ReserveText}</h2>
      <p>{guReserveIntroText}</p>
      <ul>
        {checkItems.map((it) => <li>{it}</li>)}
      </ul>

      <p>{guVisitNoteText}</p>

      <div class="notice notice--warn">
        <div class="notice__title">예약 안내</div>
        <p style="margin:0">
          전화예약 <a href={SITE.phoneHref}>{SITE.phone}</a> 로 문의해 주세요.
          허위 후기·선정적 표현 없이 정보형으로 안내합니다.
        </p>
      </div>

      <h2>인접 지역 안내</h2>
      <p>{guNeighborText}</p>
      <div class="chip-list">
        {
          neighbors.map((n) => (
            <a class="chip chip--soft" href={`/area/${g.parentSlug}/${n.regionSlug}/`}>{n.regionName}</a>
          ))
        }
        <a class="chip" href={`/area/${g.parentSlug}/`}>{sido.regionName} 전체</a>
      </div>

      <h2>{g.regionName} 자주 묻는 질문</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {areaReviews.length > 0 && <ReviewSection areaName={g.regionName} reviews={areaReviews} displayRating={rating.avg} />}
</BaseLayout>
