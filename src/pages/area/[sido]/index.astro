---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import LocalNav from "../../../components/LocalNav.astro";
import PriceTable from "../../../components/PriceTable.astro";
import ProgramLinks from "../../../components/ProgramLinks.astro";
import ReviewSection from "../../../components/ReviewSection.astro";
import { SITE } from "../../../lib/site";
import {
  sidos,
  sigungusBySido,
  stationsByGroup,
  prioritySigungus,
} from "../../../lib/data";
import {
  breadcrumbSchema,
  faqSchema,
  serviceAreaSchemaWithReviews,
} from "../../../lib/seo";
import { reviewsForArea, ratingForArea } from "../../../lib/reviews";
import { regionProse } from "../../../data/region-prose";

export function getStaticPaths() {
  return sidos.map((s) => ({ params: { sido: s.regionSlug }, props: { s } }));
}

const { s } = Astro.props;
const path = `/area/${s.regionSlug}/`;
const gus = sigungusBySido(s.regionSlug);
const priority = prioritySigungus(s.regionSlug);
const stations = stationsByGroup(s.regionSlug).slice(0, 12);

// 지역별 고유 본문 (템플릿 치환이 아닌 권역별 서술)
const prose = regionProse[s.regionSlug];

const titleMap: Record<string, string> = {
  seoul: "서울 출장마사지｜강남·잠실·홍대·여의도 홈타이 지역 안내",
  gyeonggi: "경기도 출장마사지｜수원·성남·고양·김포 홈타이 지역 안내",
  incheon: "인천 출장마사지｜부평·송도·구월·검단 홈타이 지역 안내",
  busan: "부산 출장마사지｜서면·해운대·센텀·동래 홈타이 지역 안내",
};
const descMap: Record<string, string> = {
  seoul: "서울 출장마사지 예약 전 강남·잠실·홍대·여의도·신림 생활권을 확인하세요.",
  gyeonggi: "경기도 출장마사지 예약 전 수원·성남·고양·김포·시흥 생활권을 확인하세요.",
  incheon: "인천 출장마사지 예약 전 부평·송도·구월동·검단·청라 생활권을 확인하세요.",
  busan: "부산 출장마사지 예약 전 서면·해운대·센텀·동래·수영 생활권을 확인하세요.",
};

const title = titleMap[s.regionSlug];
const description = descMap[s.regionSlug];

// 권위 있는 외부 참고 링크 (공식 교통·행정 기관) — E-E-A-T 신뢰 신호
const authRefMap: Record<string, { label: string; href: string }> = {
  seoul: { label: "서울교통공사 노선도", href: "https://www.seoulmetro.co.kr/kr/cyberStation.do" },
  gyeonggi: { label: "경기도청 교통 안내", href: "https://www.gg.go.kr/" },
  incheon: { label: "인천교통공사 노선도", href: "https://www.ictr.or.kr/" },
  busan: { label: "부산교통공사 노선도", href: "https://www.humetro.busan.kr/" },
};
const authRef = authRefMap[s.regionSlug];

const faq = [
  {
    q: `${s.regionName}에서 출장마사지·홈타이는 어떻게 예약하나요?`,
    a: `전화예약 ${SITE.phone}로 방문 위치와 가능 주소, 희망 시간을 알려주시면 ${s.regionName} 방문 가능 생활권과 추가 이동비 기준을 안내드립니다.`,
  },
  {
    q: `${s.regionName} 어느 지역까지 방문하나요?`,
    a: `${s.regionName} 주요 구·시·군과 대표 역세권 생활권을 중심으로 안내합니다. 각 지역 페이지에서 방문 가능 생활권과 인접 역을 확인할 수 있습니다.`,
  },
];

// 시드 기반 결정적 셔플 — 시도 페이지마다 다른 6개를 노출
const regionReviews = reviewsForArea(s.regionSlug, null, 6);
const rating = ratingForArea(s.regionSlug, null, regionReviews);

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "지역 안내", path: "/area/" },
    { name: s.regionName, path },
  ]),
  serviceAreaSchemaWithReviews(s.regionName, path, regionReviews, rating.avg),
  faqSchema(faq),
];
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <LocalNav homeLabel={s.regionName} homeHref={path} />
  <Breadcrumbs
    items={[
      { name: "홈", path: "/" },
      { name: "지역 안내", path: "/area/" },
      { name: s.regionName },
    ]}
  />

  <section class="section section-anchor" id="areas" style="padding-top:8px">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">{s.regionName} 지역 안내</span>
        <h1 class="section__title">
          {s.regionName} 출장마사지 · 지역별 지하철역별 홈타이 안내
        </h1>
        <p class="section__lead">{s.contentFocus}</p>
      </div>

      <h2 style="font-size:1.25rem">{s.regionName} 주요 지역</h2>
      <div class="grid grid--3" style="margin-bottom:28px">
        {
          gus.map((g) => (
            <a class="card" href={`/area/${s.regionSlug}/${g.regionSlug}/`}>
              <div class="card__title">
                {g.regionName} <span class="arrow">→</span>
              </div>
              <p class="card__desc">{g.contentFocus}</p>
              {g.nearbyStations?.length > 0 && (
                <div class="card__tags">
                  {g.nearbyStations.slice(0, 3).map((st) => (
                    <span class="tag">{st}</span>
                  ))}
                </div>
              )}
            </a>
          ))
        }
      </div>

      <h2 id="stations" class="section-anchor" style="font-size:1.25rem">{s.regionName} 대표 지하철역</h2>
      <div class="chip-list" style="margin-bottom:8px">
        {
          stations.map((st) => (
            <a class="chip chip--soft" href={`/station/${st.stationGroup}/${st.stationSlug}/`}>
              {st.stationName}
            </a>
          ))
        }
      </div>
      <p>
        <a href={`/station/${s.regionSlug}/`} style="font-weight:700">
          {s.regionName} 지하철역 전체 보기 →
        </a>
      </p>
      {
        authRef && (
          <p class="muted" style="font-size:0.875rem">
            정확한 지하철 노선과 역 위치는 공식 기관 자료인{" "}
            <a href={authRef.href} target="_blank" rel="noopener">
              {authRef.label}
            </a>
            에서 함께 확인할 수 있습니다.
          </p>
        )
      }
    </div>
  </section>

  <!-- 요금표 (메인 + 모든 지역 페이지 공통) -->
  <PriceTable areaLabel={s.regionName} seed={s.regionSlug} />

  <section class="section section--soft">
    <div class="container prose">
      <h2>{s.regionName}에서 출장마사지를 찾을 때 확인할 기준</h2>
      {prose.intro.map((para) => <p>{para}</p>)}
      <p>{prose.structure}</p>

      <h2 id="life" class="section-anchor">{s.regionName} 주요 생활권 안내</h2>
      <p>아래 생활권을 기준으로 방문 가능 지역과 인접 역을 확인할 수 있습니다.</p>
      <ul>
        {s.lifeAreas.map((l) => <li>{l}</li>)}
      </ul>
      <p>{prose.lifeOverview}</p>
      <p>
        {prose.transport} 자세한 생활권 안내는
        <a href="/life/">생활권 페이지</a>에서 확인할 수 있습니다.
      </p>

      <h2>{s.regionName} 1차 안내 지역</h2>
      <p>{prose.priorityIntro}</p>
      <div class="chip-list">
        {
          priority.map((g) => (
            <a class="chip" href={`/area/${s.regionSlug}/${g.regionSlug}/`}>{g.regionName}</a>
          ))
        }
      </div>
      <p>{prose.priorityNote}</p>

      <h2>자택·숙소·오피스텔 이용 전 확인사항</h2>
      <p>
        {prose.visitIntro} 예약 전
        <a href="/guide/before-use/">이용 전 확인사항</a>과
        <a href="/reservation/">예약 안내</a>를 함께 확인하시면 방문이 원활하며,
        도로명 주소가 헷갈릴 경우
        <a href="https://www.juso.go.kr/" target="_blank" rel="noopener">행정안전부 도로명주소</a>에서
        확인할 수 있습니다.
      </p>
      <p>{prose.visitNote}</p>
      <p>
        예약 시 방문 위치와 희망 시간, 원하는 관리 종류를 함께 알려 주시면
        {s.regionName} 내 가능한 동선과 추가 이동비 기준을 안내받기 쉽습니다.
      </p>

      <div class="notice notice--warn">
        <div class="notice__title">예약 안내</div>
        <p style="margin:0">
          전화예약 <a href={SITE.phoneHref}>{SITE.phone}</a> 로 문의해 주세요.
          본 사이트는 정보형 안내 페이지이며 불법·선정적 서비스는 제공하지
          않습니다.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ProgramLinks
        prefix={s.regionName}
        title={`${s.regionName} 마사지 프로그램 안내`}
        lead={`${s.regionName}에서 받을 수 있는 관리 종류별 안내입니다.`}
      />
    </div>
  </section>

  {regionReviews.length > 0 && <ReviewSection areaName={s.regionName} reviews={regionReviews} displayRating={rating.avg} />}

  <section class="section">
    <div class="container container--narrow">
      <div class="section__head">
        <span class="eyebrow">자주 묻는 질문</span>
        <h2 class="section__title">{s.regionName} 예약 전 자주 묻는 질문</h2>
      </div>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
