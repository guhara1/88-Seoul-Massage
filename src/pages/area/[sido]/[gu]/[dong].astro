---
// 3번째 경로 세그먼트 디스패처:
//  - 일반 시군구의 행정동 상세  → DongDetail
//  - 행정구를 둔 시(市)의 행정구 → GuArea  (시 → 구 → 동 구조)
// 두 경우 모두 /area/{sido}/{시군구}/{세그먼트}/ 형태라 한 라우트에서 분기한다.
import DongDetail from "../../../../components/DongDetail.astro";
import GuArea from "../../../../components/GuArea.astro";
import {
  allDetailDongs,
  allCityGuPaths,
  type DetailDongEntry,
} from "../../../../lib/data";

export function getStaticPaths() {
  const dongPaths = allDetailDongs().map((e) => ({
    params: { sido: e.sidoSlug, gu: e.guSlug, dong: e.dong.slug },
    props: { kind: "dong" as const, entry: e },
  }));
  const guPaths = allCityGuPaths().map((g) => ({
    params: { sido: g.sidoSlug, gu: g.citySlug, dong: g.guSlug },
    props: {
      kind: "gu" as const,
      sidoSlug: g.sidoSlug,
      citySlug: g.citySlug,
      guSlug: g.guSlug,
    },
  }));
  return [...dongPaths, ...guPaths];
}

const props = Astro.props as
  | { kind: "dong"; entry: DetailDongEntry }
  | { kind: "gu"; sidoSlug: string; citySlug: string; guSlug: string };
---

{
  props.kind === "gu" ? (
    <GuArea sidoSlug={props.sidoSlug} citySlug={props.citySlug} guSlug={props.guSlug} />
  ) : (
    <DongDetail entry={props.entry} />
  )
}
