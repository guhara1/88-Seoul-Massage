---
import { programs } from "../lib/data";

interface Props {
  /** 지역/역명 등 접두어 → 롱테일 앵커 텍스트 생성 (예: "강남구 스웨디시") */
  prefix?: string;
  /** 노출 개수 */
  limit?: number;
  title?: string;
  lead?: string;
  /** 페이지 시드 — 노출 프로그램을 페이지마다 다르게 섞는다 (중복 블록 분산) */
  seed?: string;
}
const {
  prefix = "",
  limit = 12,
  title = "마사지 프로그램 안내",
  lead = "원하는 관리 종류로 자세한 안내를 확인하세요.",
  seed = "",
} = Astro.props;

// 시드가 있으면 프로그램 순서를 결정적으로 섞어 페이지마다 다른 조합을 노출
function hashSeed(s: string): number {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}
let pool = [...programs];
if (seed) {
  // 시드 기반 정렬 키로 결정적 셔플
  pool = pool
    .map((p, i) => ({ p, k: hashSeed(`${seed}:${p.slug}`) }))
    .sort((a, b) => a.k - b.k)
    .map((x) => x.p);
}
const list = pool.slice(0, limit);
const pfx = prefix ? prefix + " " : "";
---

{
  list.length > 0 && (
    <div class="program-links">
      <h2 class="program-links__title">{title}</h2>
      {lead && <p class="program-links__lead">{lead}</p>}
      <div class="chip-list">
        {list.map((p) => (
          <a class="chip chip--soft" href={`/program/${p.slug}/`}>
            {pfx}
            {p.shortName}
          </a>
        ))}
        <a class="chip" href="/program/">전체 프로그램</a>
      </div>
    </div>
  )
}
