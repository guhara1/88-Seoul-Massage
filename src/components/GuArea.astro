---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import LocalNav from "./LocalNav.astro";
import PriceTable from "./PriceTable.astro";
import ProgramLinks from "./ProgramLinks.astro";
import ReviewSection from "./ReviewSection.astro";
import { SITE, sidoName } from "../lib/site";
import {
  getSido,
  getSigungu,
  getCityGu,
  dongsOfGu,
  hasDongDetail,
  dongDetailFor,
  stationByName,
} from "../lib/data";
import {
  breadcrumbSchema,
  faqSchema,
  serviceAreaSchemaWithReviews,
} from "../lib/seo";
import { reviewsForArea, ratingForArea } from "../lib/reviews";
import { guIntro, guReserveIntro, h1Gu, h2Intro } from "../lib/prose";

interface Props {
  sidoSlug: string;
  citySlug: string;
  guSlug: string;
}
const { sidoSlug, citySlug, guSlug } = Astro.props;

const sido = getSido(sidoSlug)!;
const city = getSigungu(sidoSlug, citySlug)!;
const gu = getCityGu(sidoSlug, citySlug, guSlug)!;

const cityPath = `/area/${sidoSlug}/${citySlug}/`;
const path = `${cityPath}${guSlug}/`;
const dongs = dongsOfGu(sidoSlug, citySlug, guSlug);

// 구 소속 동들의 인근 역을 모아 대표 역 목록 구성 (중복 제거)
const stationSet = new Set<string>();
for (const d of dongs) {
  const det = dongDetailFor(sidoSlug, citySlug, d.slug);
  det?.nearbyStations?.forEach((s) => stationSet.add(s));
}
const guStations = [...stationSet];

const dongNames = dongs.map((d) => d.name);
const title = `${gu.regionName} 출장마사지｜${dongNames
  .slice(0, 3)
  .join("·")} 홈타이 안내`;
const description = `${city.regionName} ${gu.regionName} 출장마사지 예약 전 ${dongNames
  .slice(0, 3)
  .join("·")} 생활권을 확인하세요.`;

const faq = [
  {
    q: `${city.regionName} ${gu.regionName} 출장마사지·홈타이는 어떻게 예약하나요?`,
    a: `전화예약 ${SITE.phone}로 ${gu.regionName} 내 방문 위치와 가능 주소, 희망 시간을 알려주시면 ${dongNames
      .slice(0, 4)
      .join(", ")} 등 방문 가능 생활권과 추가 이동비 기준을 안내드립니다.`,
  },
  {
    q: `${gu.regionName}은 ${city.regionName} 어느 생활권에 속하나요?`,
    a: `${gu.contentFocus} ${gu.regionName}에는 ${dongNames.join(
      ", "
    )} 등 행정동이 속해 있으며, 각 동 페이지에서 방문 가능 생활권과 인근 역을 확인할 수 있습니다.`,
  },
];

// 시드 셔플 후기 (시→구→동 구조의 구 페이지)
const guSeed = `${citySlug}/${guSlug}`;
const guReviews = reviewsForArea(sidoSlug, guSeed, 6);
const rating = ratingForArea(sidoSlug, guSeed, guReviews);

// 시드 문장 변형 — 구마다 본문 문단 구조가 달라진다
const guVars = {
  region: `${city.regionName} ${gu.regionName}`,
  sido: sido.regionName,
  focus: gu.contentFocus,
  areas: dongNames,
  stations: guStations,
};
const guAreaIntro = guIntro(guSeed, guVars);
const guAreaReserve = guReserveIntro(guSeed, guVars);

const schema = [
  breadcrumbSchema([
    { name: "홈", path: "/" },
    { name: "지역 안내", path: "/area/" },
    { name: sido.regionName, path: `/area/${sidoSlug}/` },
    { name: city.regionName, path: cityPath },
    { name: gu.regionName, path },
  ]),
  serviceAreaSchemaWithReviews(
    `${city.regionName} ${gu.regionName}`,
    path,
    guReviews,
    rating.avg
  ),
  faqSchema(faq),
];
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <LocalNav homeLabel={city.regionName} homeHref={cityPath} showLife={false} />
  <Breadcrumbs
    items={[
      { name: "홈", path: "/" },
      { name: "지역 안내", path: "/area/" },
      { name: sido.regionName, path: `/area/${sidoSlug}/` },
      { name: city.regionName, path: cityPath },
      { name: gu.regionName },
    ]}
  />

  <!-- 헤더 -->
  <section class="section" style="padding:8px 0 24px">
    <div class="container prose">
      <span class="eyebrow">{sidoName(sidoSlug)} {city.regionName} · {gu.regionName}</span>
      <h1>{h1Gu(guSeed, gu.regionName)}</h1>
      <p class="hero__sub" style="color:var(--text-soft)">
        {gu.contentFocus} {gu.regionName}의 행정동별 방문 가능 지역과 예약 전
        확인사항을 안내합니다.
      </p>
      <div class="hero__cta" style="margin-top:18px">
        <a class="btn btn--cta" href={SITE.phoneHref}>전화예약 {SITE.phone}</a>
        <a class="btn btn--outline" href={cityPath}>{city.regionName} 전체</a>
        <a class="btn btn--outline" href="/guide/before-use/">이용 전 확인사항</a>
      </div>
    </div>
  </section>

  <!-- 요금표 -->
  <PriceTable areaLabel={gu.regionName} seed={guSeed} />

  <!-- 행정동 안내 -->
  <section class="section section-anchor" id="areas">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">행정동 안내</span>
        <h2 class="section__title">{gu.regionName} 행정동별 방문 가능 지역 안내</h2>
        <p class="section__lead">
          {gu.regionName}에 속한 대표 행정동입니다. 동을 선택하면 생활권과 인근
          역, 이용 전 확인사항을 확인할 수 있습니다.
        </p>
      </div>
      <div class="area-rows">
        {
          dongs.map((d) => {
            const href = hasDongDetail(sidoSlug, citySlug, d.slug)
              ? `/area/${sidoSlug}/${citySlug}/${d.slug}/`
              : null;
            const Tag = href ? "a" : "div";
            return (
              <Tag class="area-row" href={href}>
                <b>{d.name} {href && <span class="arrow">→</span>}</b>
                <span>
                  {d.blurb ||
                    `${gu.regionName} ${d.name} 일대 주거지와 상권을 포함한 생활권입니다.`}
                </span>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 인근 역 -->
  {
    guStations.length > 0 && (
      <section class="section section--soft">
        <div class="container">
          <div class="section__head">
            <span class="eyebrow">역세권 안내</span>
            <h2 class="section__title">{gu.regionName} 인근 지하철역</h2>
            <p class="section__lead">
              {gu.regionName} 생활권과 가까운 역을 기준으로 방문 동선을 확인하세요.
            </p>
          </div>
          <div class="chip-list">
            {guStations.map((name) => {
              const st = stationByName(name);
              return st ? (
                <a class="chip" href={`/station/${st.stationGroup}/${st.stationSlug}/`}>{name}</a>
              ) : (
                <span class="chip chip--soft">{name}</span>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- 본문 -->
  <section class="section">
    <div class="container prose">
      <h2>{h2Intro(guSeed, `${city.regionName} ${gu.regionName}`)}</h2>
      {guAreaIntro.map((para) => <p>{para}</p>)}
      <p>{guAreaReserve}</p>
      <p>
        {gu.regionName} 방문 예약은 전화 <a href={SITE.phoneHref}>{SITE.phone}</a>로
        받으며, 본 사이트는 정보형 안내 페이지로 불법·선정적 서비스는 제공하지
        않습니다.
      </p>

      <ProgramLinks
        limit={8}
        seed={guSeed}
        prefix={gu.regionName}
        title={`${gu.regionName} 마사지 프로그램 안내`}
        lead={`${gu.regionName}에서 받을 수 있는 관리 종류별 안내입니다.`}
      />

      <h2>{gu.regionName} 자주 묻는 질문</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {guReviews.length > 0 && (
    <ReviewSection areaName={gu.regionName} reviews={guReviews} displayRating={rating.avg} />
  )}
</BaseLayout>
