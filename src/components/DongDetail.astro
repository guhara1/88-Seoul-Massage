---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import LocalNav from "./LocalNav.astro";
import PriceTable from "./PriceTable.astro";
import ProgramLinks from "./ProgramLinks.astro";
import ReviewSection from "./ReviewSection.astro";
import { SITE, sidoName } from "../lib/site";
import {
  getSido,
  getSigungu,
  dongsOf,
  hasDongDetail,
  stations,
  guOfDong,
  type DetailDongEntry,
} from "../lib/data";
import {
  breadcrumbSchema,
  faqSchema,
  serviceAreaSchemaWithReviews,
} from "../lib/seo";
import { reviewsForArea, ratingForArea } from "../lib/reviews";
import { dongIntro, dongCommerce, dongAccess, dongReserve, dongStationLine, dongHeroSub, checklistItems } from "../lib/prose";

interface Props {
  entry: DetailDongEntry;
}
const { entry } = Astro.props;
const { sidoSlug, guSlug, dong, detail } = entry;
const sido = getSido(sidoSlug)!;
const gu = getSigungu(sidoSlug, guSlug)!;
const guPath = `/area/${sidoSlug}/${guSlug}/`;
const path = `${guPath}${dong.slug}/`;

// 시→구→동 구조인 시(市)는 동이 속한 행정구를 브레드크럼에 끼워 넣는다
const parentGu = guOfDong(sidoSlug, guSlug, dong.slug);
const parentGuPath = parentGu ? `${guPath}${parentGu.regionSlug}/` : null;

// 인접 역 → 역 페이지(있으면) 링크
const stationLink = (name: string) => {
  const st = stations.find((s) => s.stationName === name);
  return st ? `/station/${st.stationGroup}/${st.stationSlug}/` : null;
};
// 인접 동 → 같은 구 내 상세 페이지(있으면) 링크
const guDongs = dongsOf(sidoSlug, guSlug);
const adjLink = (name: string) => {
  const d = guDongs.find((x) => x.name === name);
  return d && hasDongDetail(sidoSlug, guSlug, d.slug)
    ? `/area/${sidoSlug}/${guSlug}/${d.slug}/`
    : null;
};

// 안전 접근(빈 배열 폴백)
const lm = detail.landmarks.length ? detail.landmarks : [`${dong.name} 일대`];
const adj = detail.adjacentAreas.length ? detail.adjacentAreas : [gu.regionName];
const sts = detail.nearbyStations.length ? detail.nearbyStations : ["인근 역"];

const title = `${dong.name} 출장마사지｜${
  detail.landmarks[0] ?? detail.nearbyStations[0] ?? gu.regionName
} 생활권 홈타이 안내`;
const description = `${dong.name} 출장마사지 예약 전 ${detail.adjacentAreas
  .slice(0, 3)
  .join("·")} 인접 생활권을 확인하세요.`;

const faq = [
  {
    q: `${dong.name} 출장마사지·홈타이는 어떻게 예약하나요?`,
    a: `전화예약 ${SITE.phone}로 ${dong.name} 내 방문 위치와 가능 주소, 희망 시간을 알려주시면 ${detail.nearbyStations.join(", ")} 인근 방문 가능 생활권과 추가 이동비 기준을 안내드립니다.`,
  },
  {
    q: `${dong.name}은 ${gu.regionName} 어느 생활권에 속하나요?`,
    a: `${dong.name}은 ${detail.character} 성격으로, ${detail.adjacentAreas.join(", ")} 등과 인접해 있습니다. 방문 동선은 ${detail.nearbyStations[0]} 기준으로 확인하면 편리합니다.`,
  },
];

const crumbs = [
  { name: "홈", path: "/" },
  { name: "지역 안내", path: "/area/" },
  { name: sido.regionName, path: `/area/${sidoSlug}/` },
  { name: gu.regionName, path: guPath },
  ...(parentGu && parentGuPath
    ? [{ name: parentGu.regionName, path: parentGuPath }]
    : []),
  { name: dong.name, path },
];

// 시드 셔플 후기 — 각 동 페이지마다 다른 6개 노출 (도어웨이 신호 완화)
const dongSeed = `${guSlug}/${dong.slug}`;
const dongReviews = reviewsForArea(sidoSlug, dongSeed, 6);
const rating = ratingForArea(sidoSlug, dongSeed, dongReviews);

// 시드 기반 문장 변형 — 동마다 본문 문단 구조가 달라진다 (중복 본문 방지)
const dvars = {
  dong: dong.name,
  gu: gu.regionName,
  character: detail.character,
  landmarks: detail.landmarks,
  adjacent: detail.adjacentAreas,
  stations: detail.nearbyStations,
};
const dongIntroPara = dongIntro(dongSeed, dvars);
const dongCommercePara = dongCommerce(dongSeed, dvars);
const dongAccessPara = dongAccess(dongSeed, dvars);
const dongReservePara = dongReserve(dongSeed, dvars);
const dongStationLineText = dongStationLine(dongSeed, dvars);
const dongHeroSubText = dongHeroSub(dongSeed, dvars);
const checkItems = checklistItems(dongSeed);

const schema = [
  breadcrumbSchema(crumbs),
  serviceAreaSchemaWithReviews(dong.name, path, dongReviews, rating.avg),
  faqSchema(faq),
];
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <LocalNav homeLabel={gu.regionName} homeHref={guPath} showLife={false} />
  <Breadcrumbs items={crumbs.map((c, i) => (i === crumbs.length - 1 ? { name: c.name } : c))} />

  <section class="section" style="padding:8px 0 0">
    <div class="container prose">
      <span class="eyebrow">
        {sidoName(sidoSlug)} {gu.regionName}{parentGu ? ` ${parentGu.regionName}` : ""} · {dong.name}
      </span>
      <h1>{dong.name} 출장마사지 · {dong.name} 홈타이 예약 안내</h1>
      <p class="hero__sub" style="color:var(--text-soft)">{dongHeroSubText}</p>
      <div class="hero__cta" style="margin-top:18px">
        <a class="btn btn--cta" href={SITE.phoneHref}>전화예약 {SITE.phone}</a>
        {
          parentGu && parentGuPath ? (
            <a class="btn btn--outline" href={parentGuPath}>{parentGu.regionName} 전체</a>
          ) : (
            <a class="btn btn--outline" href={guPath}>{gu.regionName} 전체</a>
          )
        }
      </div>

      <h2>{dong.name} 생활권 소개</h2>
      <p>{detail.p1}</p>
      <p>{dongIntroPara}</p>
      {
        detail.landmarks.length > 0 && (
          <div class="chip-list" style="margin:8px 0 4px">
            {detail.landmarks.map((l) => (
              <span class="chip chip--soft">{l}</span>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- 요금표 (메인 + 모든 지역 페이지 공통) -->
  <PriceTable areaLabel={dong.name} seed={dongSeed} />

  <section class="section">
    <div class="container prose">
      <h2>{dong.name} 주변 상권·주거 환경</h2>
      <p>{dongCommercePara}</p>

      <h2>{dong.name} 주변 방문 가능 지역</h2>
      <p>{detail.p2}</p>
      <p>{dongAccessPara}</p>

      <h3>{dong.name} 인근 지하철역</h3>
      <p>{dongStationLineText}</p>
      <div class="chip-list">
        {
          detail.nearbyStations.map((name) => {
            const href = stationLink(name);
            return href ? (
              <a class="chip" href={href}>{name}</a>
            ) : (
              <span class="chip chip--soft">{name}</span>
            );
          })
        }
      </div>

      <h3>{dong.name} 인접 지역</h3>
      <div class="chip-list">
        {
          detail.adjacentAreas.map((name) => {
            const href = adjLink(name);
            return href ? (
              <a class="chip" href={href}>{name}</a>
            ) : (
              <span class="chip chip--soft">{name}</span>
            );
          })
        }
        <a class="chip" href={guPath}>{gu.regionName} 전체</a>
      </div>

      <h2>{dong.name} 예약 전 확인사항</h2>
      <p>{detail.p3}</p>
      <p>{dongReservePara}</p>
      <ul>
        {checkItems.map((it) => <li>{it}</li>)}
      </ul>

      <div class="notice notice--warn">
        <div class="notice__title">예약 안내</div>
        <p style="margin:0">
          전화예약 <a href={SITE.phoneHref}>{SITE.phone}</a> 로 문의해 주세요.
          {dong.name} 안내는 정보형이며 허위 후기·선정적 표현을 사용하지 않습니다.
        </p>
      </div>

      <ProgramLinks
        limit={8}
        seed={dongSeed}
        prefix={dong.name}
        title={`${dong.name} 마사지 프로그램 안내`}
        lead={`${dong.name}에서 받을 수 있는 관리 종류별 안내입니다.`}
      />

      <h2>{dong.name} 자주 묻는 질문</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {dongReviews.length > 0 && (
    <ReviewSection areaName={dong.name} reviews={dongReviews} displayRating={rating.avg} />
  )}
</BaseLayout>
